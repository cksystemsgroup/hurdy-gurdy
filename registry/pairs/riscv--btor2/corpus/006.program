    .align 2
S_cond_11: .word 0
    .align 2
S_cond_12: .word 0
    .align 2
S_cond_13: .word 0
    .text
_start:
    j N0
N0:
    li a0, 255
    andi a0, a0, 255
    la a1, S_c_2
    sb a0, 0(a1)
    fence
    j N1
N1:
    la a0, S_c_2
    lbu a0, 0(a0)
