# c--riscv: the elaborated CFG as RV64 assembly, one fence per node
    .data
    .align 2
S__t1: .word 0
    .align 0
S_c_2: .byte 0
    .align 2
S_cond_3: .word 0
    .align 2
S_s_4: .word 0
    .align 2
S_cond_5: .word 0
    .align 2
S_one_6: .word 0
    .align 2
S_cond_7: .word 0
