    sd a0, 0(sp)
    li a0, 1
    ld a1, 0(sp)
    addi sp, sp, 8
    addw a0, a1, a0
    sext.w a0, a0
    andi a0, a0, 255
    la a1, S_c_2
    sb a0, 0(a1)
    fence
    j N2
