# c--riscv: the elaborated CFG as RV64 assembly, one fence per node
    .data
    .align 2
S__t1: .word 0
    .align 2
S_x_2: .word 0
    .align 2
S_i_3: .word 0
    .align 2
S_cond_4: .word 0
    .align 2
S_cond_5: .word 0
    .text
_start:
    j N0
N0:
    li a0, 0
    la a1, S_x_2
    sw a0, 0(a1)
    fence
    j N1
N1:
    li a0, 0
    la a1, S_i_3
    sw a0, 0(a1)
    fence
    j N2
N2:
    la a0, S_i_3
    lw a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 3
    ld a1, 0(sp)
    addi sp, sp, 8
    slt a0, a1, a0
    fence
    bnez a0, N3
    j N5
N3:
    la a0, S_x_2
    lw a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 2
    ld a1, 0(sp)
    addi sp, sp, 8
    addw a0, a1, a0
    sext.w a0, a0
    la a1, S_x_2
    sw a0, 0(a1)
    fence
    j N4
N4:
    la a0, S_i_3
    lw a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 1
    ld a1, 0(sp)
    addi sp, sp, 8
    addw a0, a1, a0
    sext.w a0, a0
    la a1, S_i_3
    sw a0, 0(a1)
    fence
    j N2
N5:
    la a0, S_x_2
    lw a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 6
    ld a1, 0(sp)
    addi sp, sp, 8
    xor a0, a1, a0
    seqz a0, a0
    la a1, S_cond_4
    sw a0, 0(a1)
    fence
    j N6
N6:
    la a0, S_cond_4
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N7
N7:
    la a0, S_x_2
    lw a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 7
    ld a1, 0(sp)
    addi sp, sp, 8
    xor a0, a1, a0
    seqz a0, a0
    la a1, S_cond_5
    sw a0, 0(a1)
    fence
    j N8
N8:
    la a0, S_cond_5
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N9
N9:
    li a0, 0
    la a1, S__t1
    sw a0, 0(a1)
    fence
    j HALT
HALT:
    li a7, 93
    ecall
ERR:
    ebreak
