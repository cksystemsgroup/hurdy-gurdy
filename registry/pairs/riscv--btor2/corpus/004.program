# c--riscv: the elaborated CFG as RV64 assembly, one fence per node
    .data
    .align 2
S__t1: .word 0
    .align 2
S_a_2: .word 0
    .align 2
S_b_3: .word 0
    .align 2
S_cond_4: .word 0
    .align 3
S_w_5: .dword 0
    .align 2
S_cond_6: .word 0
    .align 0
S_h_7: .byte 0
    .align 2
S_cond_8: .word 0
    .align 2
S_cond_9: .word 0
    .text
_start:
    j N0
N0:
    li a0, 1
    negw a0, a0
    sext.w a0, a0
    la a1, S_a_2
    sw a0, 0(a1)
    fence
    j N1
N1:
    li a0, 1
    slli a0, a0, 32
    srli a0, a0, 32
    la a1, S_b_3
    sw a0, 0(a1)
    fence
    j N2
N2:
    la a0, S_a_2
    lw a0, 0(a0)
    slli a0, a0, 32
    srli a0, a0, 32
    addi sp, sp, -8
    sd a0, 0(sp)
    la a0, S_b_3
    lwu a0, 0(a0)
    ld a1, 0(sp)
    addi sp, sp, 8
    sltu a0, a0, a1
    la a1, S_cond_4
    sw a0, 0(a1)
    fence
    j N3
N3:
    la a0, S_cond_4
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N4
N4:
    li a0, 1
    negw a0, a0
    sext.w a0, a0
    la a1, S_w_5
    sd a0, 0(a1)
    fence
    j N5
N5:
    la a0, S_w_5
    ld a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    la a0, S_b_3
    lwu a0, 0(a0)
    ld a1, 0(sp)
    addi sp, sp, 8
    slt a0, a1, a0
    la a1, S_cond_6
    sw a0, 0(a1)
    fence
    j N6
N6:
    la a0, S_cond_6
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N7
N7:
    li a0, 200
    andi a0, a0, 255
    la a1, S_h_7
    sb a0, 0(a1)
    fence
    j N8
N8:
    la a0, S_h_7
    lbu a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 2
    ld a1, 0(sp)
    addi sp, sp, 8
    mulw a0, a1, a0
    sext.w a0, a0
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 400
    ld a1, 0(sp)
    addi sp, sp, 8
    xor a0, a1, a0
    seqz a0, a0
    la a1, S_cond_8
    sw a0, 0(a1)
    fence
    j N9
N9:
    la a0, S_cond_8
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N10
N10:
    li a0, 0
    la a1, S_cond_9
    sw a0, 0(a1)
    fence
    j N11
N11:
    la a0, S_cond_9
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N12
N12:
    li a0, 0
    la a1, S__t1
    sw a0, 0(a1)
    fence
    j HALT
HALT:
    li a7, 93
    ecall
ERR:
    ebreak
