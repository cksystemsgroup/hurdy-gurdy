# c--riscv: the elaborated CFG as RV64 assembly, one fence per node
    .data
    .align 2
S__t1: .word 0
    .align 2
S_a_2: .word 0
    .align 2
S__t3: .word 0
    .align 0
S_b_4: .byte 0
    .align 0
S__t5: .byte 0
    .align 1
S_c_6: .half 0
    .align 1
S__t7: .half 0
    .align 2
S_cond_8: .word 0
    .align 2
S_cond_9: .word 0
    .align 2
S_cond_10: .word 0
    .align 2
S_sum_11: .word 0
    .align 2
S_cond_12: .word 0
    .align 2
S_cond_13: .word 0
    .text
_start:
    j N0
N0:
    li a1, 1
    li a7, 1
    ecall
    sext.w a0, a0
    la a1, S__t3
    sw a0, 0(a1)
    fence
    j N1
N1:
    la a0, S__t3
    lw a0, 0(a0)
    la a1, S_a_2
    sw a0, 0(a1)
    fence
    j N2
N2:
    li a1, 2
    li a7, 1
    ecall
    andi a0, a0, 255
    la a1, S__t5
    sb a0, 0(a1)
    fence
    j N3
N3:
    la a0, S__t5
    lbu a0, 0(a0)
    la a1, S_b_4
    sb a0, 0(a1)
    fence
    j N4
N4:
    li a1, 3
    li a7, 1
    ecall
    slli a0, a0, 48
    srai a0, a0, 48
    la a1, S__t7
    sh a0, 0(a1)
    fence
    j N5
N5:
    la a0, S__t7
    lh a0, 0(a0)
    la a1, S_c_6
    sh a0, 0(a1)
    fence
    j N6
N6:
    la a0, S_a_2
    lw a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 41
    negw a0, a0
    sext.w a0, a0
    ld a1, 0(sp)
    addi sp, sp, 8
    xor a0, a1, a0
    seqz a0, a0
    la a1, S_cond_8
    sw a0, 0(a1)
    fence
    j N7
N7:
    la a0, S_cond_8
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N8
N8:
    la a0, S_b_4
    lbu a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 44
    ld a1, 0(sp)
    addi sp, sp, 8
    xor a0, a1, a0
    seqz a0, a0
    la a1, S_cond_9
    sw a0, 0(a1)
    fence
    j N9
N9:
    la a0, S_cond_9
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N10
N10:
    la a0, S_c_6
    lh a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 1
    negw a0, a0
    sext.w a0, a0
    ld a1, 0(sp)
    addi sp, sp, 8
    xor a0, a1, a0
    seqz a0, a0
    la a1, S_cond_10
    sw a0, 0(a1)
    fence
    j N11
N11:
    la a0, S_cond_10
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N12
N12:
    la a0, S_a_2
    lw a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    la a0, S_b_4
    lbu a0, 0(a0)
    ld a1, 0(sp)
    addi sp, sp, 8
    addw a0, a1, a0
    sext.w a0, a0
    addi sp, sp, -8
    sd a0, 0(sp)
    la a0, S_c_6
    lh a0, 0(a0)
    ld a1, 0(sp)
    addi sp, sp, 8
    addw a0, a1, a0
    sext.w a0, a0
    la a1, S_sum_11
    sw a0, 0(a1)
    fence
    j N13
N13:
    la a0, S_sum_11
    lw a0, 0(a0)
    addi sp, sp, -8
    sd a0, 0(sp)
    li a0, 2
    ld a1, 0(sp)
    addi sp, sp, 8
    xor a0, a1, a0
    seqz a0, a0
    la a1, S_cond_12
    sw a0, 0(a1)
    fence
    j N14
N14:
    la a0, S_cond_12
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N15
N15:
    li a0, 0
    la a1, S_cond_13
    sw a0, 0(a1)
    fence
    j N16
N16:
    la a0, S_cond_13
    lw a0, 0(a0)
    seqz a0, a0
    fence
    bnez a0, ERR
    j N17
N17:
    li a0, 0
    la a1, S__t1
    sw a0, 0(a1)
    fence
    j HALT
HALT:
    li a7, 93
    ecall
ERR:
    ebreak
