/* arrays: element writes and reads, two dimensions, and the guarded
   out-of-range semantics (reads 0, writes dropped) */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "005.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  int a[3];
  int i = 0;
  while (i < 3) { a[i] = 10 * (i + 1); i = i + 1; }
  __VERIFIER_assert(a[0] + a[1] + a[2] == 60);
  a[5] = 77;
  __VERIFIER_assert(a[0] == 10 && a[1] == 20 && a[2] == 30);
  __VERIFIER_assert(a[5] == 0);
  int neg = -1;
  __VERIFIER_assert(a[neg] == 0);
  int m[2][3];
  m[1][2] = 42;
  __VERIFIER_assert(m[1][2] == 42 && m[0][2] == 0);
  __VERIFIER_assert(0);
  return 0;
}
