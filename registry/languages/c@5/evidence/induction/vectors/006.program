/* a global constant is asserted forever: the invariant is every bit of
   x, the one pc bit that only the error location sets, and, at the
   node that branches on the assertion, the bit that decides it */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
extern int __VERIFIER_nondet_int(void);
void reach_error() { __assert_fail("0", "const_g.c", 3, "reach_error"); }
void __VERIFIER_assert(int cond) { if (!(cond)) { ERROR: {reach_error();} } return; }
int x = 5;
int main() {
  x = x + 0;
  x = x + 0;
  while (__VERIFIER_nondet_int()) {
    __VERIFIER_assert(x == 5);
  }
  return 0;
}
