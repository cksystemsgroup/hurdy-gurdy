/* usual arithmetic conversions: -1 compared against unsigned converts
   to UINT_MAX; unsigned char promotes to int so 200*2 is 400 */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "003.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  int a = -1;
  unsigned int b = 1;
  __VERIFIER_assert(!(a < b));
  __VERIFIER_assert(a > b);
  unsigned char h = 200;
  int p = h * 2;
  __VERIFIER_assert(p == 400);
  long long w = -1;
  unsigned int q = 5;
  __VERIFIER_assert(w < q);
  __VERIFIER_assert(0);
  return 0;
}
