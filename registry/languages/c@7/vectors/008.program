/* arrays: element write/read, a two-dimensional array, a global
   initializer, out-of-range reads are 0 and writes are dropped */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "008.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int g[4] = {5, 6, 7, 8};
int main() {
  int a[3];
  a[0] = 10; a[1] = 20; a[2] = 30;
  __VERIFIER_assert(a[1] == 20);
  int m[2][3];
  m[1][2] = 42;
  __VERIFIER_assert(m[1][2] == 42);
  __VERIFIER_assert(m[0][0] == 0);
  __VERIFIER_assert(g[3] == 8);
  __VERIFIER_assert(a[7] == 0);
  a[9] = 1;
  __VERIFIER_assert(a[0] == 10);
  __VERIFIER_assert(0);
  return 0;
}
