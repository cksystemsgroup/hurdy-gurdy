/* comparisons, shifts within the width, and the unary operators on signed char */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "order_signed_char.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  signed char a = 100;
  signed char b = 27;
  signed char c = (-128);
  signed char d = 3;
  __VERIFIER_assert(
        ((a < b) == 0)
      & ((c < d) == 1)
      & ((a < a) == 0)
      & ((d < c) == 0)
      & ((a <= b) == 0)
      & ((c <= d) == 1)
      & ((a <= a) == 1)
      & ((d <= c) == 0)
      & ((a > b) == 1)
      & ((c > d) == 0)
      & ((a > a) == 0)
      & ((d > c) == 1)
      & ((a >= b) == 1)
      & ((c >= d) == 0)
      & ((a >= a) == 1)
      & ((d >= c) == 1)
      & ((a == b) == 0)
      & ((c == d) == 0)
      & ((a == a) == 1)
      & ((d == c) == 0)
      & ((a != b) == 1)
      & ((c != d) == 1)
      & ((a != a) == 0)
      & ((d != c) == 1)
      & ((a >> 0) == 100)
      & ((a >> 1) == 50)
      & ((a >> 31) == 0)
      & ((-a) == (-100))
      & ((~a) == (-101))
      & ((!a) == 0)
      & ((+a) == 100)
      & ((c >> 0) == (-128))
      & ((c >> 1) == (-64))
      & ((c >> 31) == (-1))
      & ((-c) == 128)
      & ((~c) == 127)
      & ((!c) == 0)
      & ((+c) == (-128))
      & ((d << 3) == 24));
  return 0;
}
