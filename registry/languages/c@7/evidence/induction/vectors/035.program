/* comparisons, shifts within the width, and the unary operators on short */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "order_short.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  short a = 30000;
  short b = 2767;
  short c = (-32768);
  short d = 5;
  __VERIFIER_assert(
        ((a < b) == 0)
      & ((c < d) == 1)
      & ((a < a) == 0)
      & ((d < c) == 0)
      & ((a <= b) == 0)
      & ((c <= d) == 1)
      & ((a <= a) == 1)
      & ((d <= c) == 0)
      & ((a > b) == 1)
      & ((c > d) == 0)
      & ((a > a) == 0)
      & ((d > c) == 1)
      & ((a >= b) == 1)
      & ((c >= d) == 0)
      & ((a >= a) == 1)
      & ((d >= c) == 1)
      & ((a == b) == 0)
      & ((c == d) == 0)
      & ((a == a) == 1)
      & ((d == c) == 0)
      & ((a != b) == 1)
      & ((c != d) == 1)
      & ((a != a) == 0)
      & ((d != c) == 1)
      & ((a >> 0) == 30000)
      & ((a >> 1) == 15000)
      & ((a >> 31) == 0)
      & ((-a) == (-30000))
      & ((~a) == (-30001))
      & ((!a) == 0)
      & ((+a) == 30000)
      & ((c >> 0) == (-32768))
      & ((c >> 1) == (-16384))
      & ((c >> 31) == (-1))
      & ((-c) == 32768)
      & ((~c) == 32767)
      & ((!c) == 0)
      & ((+c) == (-32768))
      & ((d << 3) == 40));
  return 0;
}
