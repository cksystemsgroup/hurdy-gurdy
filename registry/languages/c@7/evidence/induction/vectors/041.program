/* the fragment's stipulation on the one signed overflow of division: the quotient wraps to the dividend, the remainder is 0 */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "stipulated_overflow.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  int m = (-2147483647 - 1);
  int o = -1;
  __VERIFIER_assert(
        ((m / o) == (-2147483647 - 1))
      & ((m % o) == 0));
  return 0;
}
