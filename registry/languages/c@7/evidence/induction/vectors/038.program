/* comparisons, shifts within the width, and the unary operators on unsigned int */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "order_unsigned_int.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  unsigned int a = 4294967295u;
  unsigned int b = 2u;
  unsigned int c = 7u;
  unsigned int d = 4294967290u;
  __VERIFIER_assert(
        ((a < b) == 0)
      & ((c < d) == 1)
      & ((a < a) == 0)
      & ((d < c) == 0)
      & ((a <= b) == 0)
      & ((c <= d) == 1)
      & ((a <= a) == 1)
      & ((d <= c) == 0)
      & ((a > b) == 1)
      & ((c > d) == 0)
      & ((a > a) == 0)
      & ((d > c) == 1)
      & ((a >= b) == 1)
      & ((c >= d) == 0)
      & ((a >= a) == 1)
      & ((d >= c) == 1)
      & ((a == b) == 0)
      & ((c == d) == 0)
      & ((a == a) == 1)
      & ((d == c) == 0)
      & ((a != b) == 1)
      & ((c != d) == 1)
      & ((a != a) == 0)
      & ((d != c) == 1)
      & ((a >> 0) == 4294967295u)
      & ((a >> 1) == 2147483647u)
      & ((a >> 31) == 1u)
      & ((-a) == 1u)
      & ((~a) == 0u)
      & ((!a) == 0)
      & ((+a) == 4294967295u)
      & ((c >> 0) == 7u)
      & ((c >> 1) == 3u)
      & ((c >> 31) == 0u)
      & ((-c) == 4294967289u)
      & ((~c) == 4294967288u)
      & ((!c) == 0)
      & ((+c) == 7u)
      & ((a << 0) == 4294967295u)
      & ((a << 1) == 4294967294u)
      & ((a << 31) == 2147483648u));
  return 0;
}
