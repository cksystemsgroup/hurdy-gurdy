/* comparisons, shifts within the width, and the unary operators on int */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "order_int.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  int a = 2147483647;
  int b = 1;
  int c = (-7);
  int d = 2;
  __VERIFIER_assert(
        ((a < b) == 0)
      & ((c < d) == 1)
      & ((a < a) == 0)
      & ((d < c) == 0)
      & ((a <= b) == 0)
      & ((c <= d) == 1)
      & ((a <= a) == 1)
      & ((d <= c) == 0)
      & ((a > b) == 1)
      & ((c > d) == 0)
      & ((a > a) == 0)
      & ((d > c) == 1)
      & ((a >= b) == 1)
      & ((c >= d) == 0)
      & ((a >= a) == 1)
      & ((d >= c) == 1)
      & ((a == b) == 0)
      & ((c == d) == 0)
      & ((a == a) == 1)
      & ((d == c) == 0)
      & ((a != b) == 1)
      & ((c != d) == 1)
      & ((a != a) == 0)
      & ((d != c) == 1)
      & ((a >> 0) == 2147483647)
      & ((a >> 1) == 1073741823)
      & ((a >> 31) == 0)
      & ((-a) == (-2147483647))
      & ((~a) == (-2147483647 - 1))
      & ((!a) == 0)
      & ((+a) == 2147483647)
      & ((c >> 0) == (-7))
      & ((c >> 1) == (-4))
      & ((c >> 31) == (-1))
      & ((-c) == 7)
      & ((~c) == 6)
      & ((!c) == 0)
      & ((+c) == (-7))
      & ((d << 3) == 16));
  return 0;
}
