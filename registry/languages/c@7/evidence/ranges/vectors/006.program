/* addition, subtraction, multiplication and the bitwise operators on int: the operands promote, the result wraps at its own type */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "arith_int.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  int a = 2147483647;
  int b = 1;
  int c = (-7);
  int d = 2;
  __VERIFIER_assert(
        ((a + b) == (-2147483647 - 1))
      & ((c + d) == (-5))
      & ((b + c) == (-6))
      & ((a - b) == 2147483646)
      & ((c - d) == (-9))
      & ((b - c) == 8)
      & ((a & b) == 1)
      & ((c & d) == 0)
      & ((b & c) == 1)
      & ((a | b) == 2147483647)
      & ((c | d) == (-5))
      & ((b | c) == (-7))
      & ((a ^ b) == 2147483646)
      & ((c ^ d) == (-5))
      & ((b ^ c) == (-8))
      & ((a * b) == 2147483647)
      & ((c * d) == (-14)));
  return 0;
}
