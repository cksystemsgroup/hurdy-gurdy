/* division and remainder on int: truncation toward zero, the remainder taking the dividend's sign */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "div_int_1.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  int a = 7;
  int b = (-2);
  __VERIFIER_assert(
        ((a / b) == (-3))
      & ((a % b) == 1));
  return 0;
}
