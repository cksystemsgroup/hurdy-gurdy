/* division and remainder on unsigned long long: truncation toward zero, the remainder taking the dividend's sign */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "div_unsigned_long_long.c", 2, "reach_error"); }
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  unsigned long long a = 18446744073709551610ULL;
  unsigned long long b = 7ULL;
  __VERIFIER_assert(
        ((a / b) == 2635249153387078801ULL)
      & ((a % b) == 3ULL));
  return 0;
}
