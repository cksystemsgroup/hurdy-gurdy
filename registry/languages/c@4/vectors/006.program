/* input reads are addressed by (site, frame): h1 and h2 read the frame
   at which each havoc executes, missing entries are 0, and the value's
   bits are taken at the read's C type */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "006.c", 2, "reach_error"); }
extern int __VERIFIER_nondet_int(void);
extern unsigned char __VERIFIER_nondet_uchar(void);
extern int __VERIFIER_nondet_short(void);
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  int a = __VERIFIER_nondet_int();
  unsigned char b = __VERIFIER_nondet_uchar();
  int c = __VERIFIER_nondet_int();
  __VERIFIER_assert(a == 41);
  __VERIFIER_assert(b == 44);
  __VERIFIER_assert(c == 0);
  __VERIFIER_assert(0);
  return 0;
}
