/* halt then stutter: the program returns early; depth is the number
   of frames run, not the step it halted at */
extern void abort(void);
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "009.c", 2, "reach_error"); }
int main() {
  int x = 1;
  x = x + 1;
  if (x == 2) { return 0; }
  reach_error();
  return 0;
}
