/* halt is absorbing: once main has returned nothing runs again, so an
   input that would fail the assertion at a later frame is never read */
extern void __assert_fail(const char *, const char *, unsigned int, const char *) __attribute__ ((__noreturn__));
void reach_error() { __assert_fail("0", "017.c", 2, "reach_error"); }
extern int __VERIFIER_nondet_int(void);
void __VERIFIER_assert(int cond) {
  if (!(cond)) { ERROR: {reach_error();} }
  return;
}
int main() {
  int a = __VERIFIER_nondet_int();
  __VERIFIER_assert(a == 0);
  return 0;
}
