  "state" -> "state" [style=dotted, label="state--state"];
  "terminal:btor2-bdd" [shape=doubleoctagon, label="btor2-bdd"];
  "btor2" -> "terminal:btor2-bdd" [style=solid, label="btor2-bdd (3)"];
  "terminal:btor2-bmcf" [shape=doubleoctagon, label="btor2-bmcf"];
  "btor2" -> "terminal:btor2-bmcf" [style=solid, label="btor2-bmcf (50)"];
  "terminal:btor2-ic3" [shape=doubleoctagon, label="btor2-ic3"];
  "btor2" -> "terminal:btor2-ic3" [style=dotted, label="btor2-ic3"];
  "terminal:btor2-ind" [shape=doubleoctagon, label="btor2-ind"];
  "btor2" -> "terminal:btor2-ind" [style=dotted, label="btor2-ind"];
  "terminal:btor2-sim" [shape=doubleoctagon, label="btor2-sim"];
  "btor2" -> "terminal:btor2-sim" [style=dotted, label="btor2-sim"];
}
