digraph "hwmcc24-arrays" {
  rankdir=LR; labelloc=t;
  label="hwmcc24-arrays: 5 of 55 settled; frontier holds 50";
  node [shape=box];
  "btor2" [peripheries=2, label="btor2\n55 questions, 50 open"];
  "state";
