digraph "btor2-demo" {
  rankdir=LR; labelloc=t;
  label="btor2-demo: 3 of 3 terminal; frontier holds 0";
  node [shape=box];
  "btor2" [peripheries=2, label="btor2\n3 questions, 0 open"];
  "ebpf";
  "evm";
  "formula";
  "python";
  "riscv";
  "sail";
  "smiles";
  "smtlib";
  "wasm";
  "result" [shape=doubleoctagon];
  "btor2" -> "result" [style=dotted, label="btor2--abc"];
  "btor2" -> "result" [style=dotted, label="btor2--avr"];
  "btor2" -> "result" [style=bold, label="btor2--btormc (1)"];
  "btor2" -> "result" [style=dotted, label="btor2--enum"];
  "btor2" -> "result" [style=bold, label="btor2--pono-cert (2)"];
  "btor2" -> "smtlib" [style=dotted, label="btor2--smtlib"];
  "btor2" -> "result" [style=dotted, label="btor2--z3"];
  "ebpf" -> "btor2" [style=dotted, label="ebpf--btor2"];
  "evm" -> "btor2" [style=dotted, label="evm--btor2"];
  "python" -> "smtlib" [style=dotted, label="python--smtlib"];
  "riscv" -> "btor2" [style=dotted, label="riscv--btor2"];
  "riscv" -> "sail" [style=dotted, label="riscv--sail"];
  "sail" -> "btor2" [style=dotted, label="sail--btor2"];
  "smiles" -> "formula" [style=dotted, label="smiles--formula"];
  "smtlib" -> "result" [style=dotted, label="smtlib--bitwuzla"];
  "smtlib" -> "result" [style=dotted, label="smtlib--z3"];
  "wasm" -> "btor2" [style=dotted, label="wasm--btor2"];
}
